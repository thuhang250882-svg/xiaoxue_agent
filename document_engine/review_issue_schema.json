{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeologyReportReviewIssue",
  "type": "object",
  "required": ["id", "type", "location", "originalText", "issue", "severity", "suggestion", "basis", "needHumanConfirm"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "location": { "type": "string" },
    "originalText": { "type": "string" },
    "issue": { "type": "string" },
    "severity": { "type": "string", "enum": ["高", "中", "低"] },
    "suggestion": { "type": "string" },
    "basis": { "type": "string" },
    "needHumanConfirm": { "type": "boolean" }
  }
}